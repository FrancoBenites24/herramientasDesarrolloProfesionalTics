# Configuración de Servidor n8n
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
NODE_ENV=production
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima

# Configuración de Acceso y Onboarding
# Desactiva la pantalla de login/registro para acceso directo inmediato
N8N_USER_MANAGEMENT_DISABLED=true
# Desactiva telemetría y encuestas iniciales
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
